# Template for building the MaxText Colocated Python image.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y git

WORKDIR /app

# Copy the current directory (MaxText repo) into the image
COPY . /app/maxtext/

# Install MaxText dependencies
RUN uv pip install --upgrade pip setuptools wheel
RUN uv pip install -r maxtext/src/dependencies/requirements/generated_requirements/tpu-requirements.txt -c /opt/venv/server_constraints.txt

# Overwrite colocated_python_backend.py with patched implementation and recompile pyc
RUN cp /app/maxtext/colocated_python_backend.py /opt/venv/lib/python3.12/site-packages/pathways_sidecar/colocated_python_backend.py && \
    rm -f /opt/venv/lib/python3.12/site-packages/pathways_sidecar/__pycache__/colocated_python_backend* && \
    python3 -m py_compile /opt/venv/lib/python3.12/site-packages/pathways_sidecar/colocated_python_backend.py

# Overwrite pathwaysutils with updated elasticity error classification
RUN cp -r /app/maxtext/pathwaysutils /opt/venv/lib/python3.12/site-packages/pathwaysutils && \
    rm -rf /opt/venv/lib/python3.12/site-packages/pathwaysutils/__pycache__

# Ensure MaxText src is in PYTHONPATH
ENV PYTHONPATH=/app/maxtext/src:$PYTHONPATH

WORKDIR /app/maxtext
