# libtpu flags of MaxText's tuned v5p DeepSeek-V3 recipe, for both sides of a v5p comparison: the XLA_FLAGS of
# tpu-recipes training/v5p/DeepSeek3-671B-MaxText/cluster_toolkit/run_recipe.sh (tpu-recipes 2a2f894c95,
# 2026-10-02), which takes them from MaxText's benchmarks/maxtext_v5p_model_configs.py `deepseek3_671b_v5p_1024`:
# ENABLE_SPARSECORE_OFFLOADING_FOR_RS_AG_AR + HOST_OFFLOAD_FLAGS + LAYOUT_FOR_ALL_REDUCE_SCATTER +
# DATA_PARALLEL_OVERLAP + MOE_VMEM_LIMIT_FLAG + DISABLE_MEGACORE_FUSION_ALLOW_AGS + ENABLE_ASYNC_COLLECTIVE_PERMUTE.
# The recipe image runs libtpu 0.0.46, as the MPMD image does.  One flag per line; '#' lines are comments.
# One recipe flag is left out: --2a886c8_chip_config_name=megachip_tccontrol.  libtpu 0.0.46 rejects it ("Unknown
# command line flag"), and MaxText dropped it from ENABLE_SPARSECORE_OFFLOADING_BASE_FLAGS on 2026-01-26 (commit
# "remove --2a886c8_chip_config_name flag in sparsecore offloading"); the recipe's flags predate that.
# libtpu 0.0.46 accepts the chip config megachip_tccontrol under another flag name; set that way, it made no
# difference to MaxText on a v5p-128 (10673 vs 10676 ms a step, one slice, 2026-10).
# The set names its own scoped VMEM limit (81920 KiB, MOE_VMEM_LIMIT_FLAG).  The launchers (ds_ep_run.sh,
# ds_ep_aot.sh, ds_ep_multihost.sh) run it with MPMD_FLAG_SET=v5p, adding
# --xla_max_concurrent_async_collective_permutes=64.  v5p_fsdp_extra.flags adds to it, through EXTRA_LIBTPU_INIT_ARGS.
# Read with: grep -v '^#' src/maxtext/experimental/mpmd/jax/libtpu_flags/v5p.flags | tr '\n' ' '
--xla_tpu_enable_async_collective_fusion_fuse_all_gather=false
--xla_tpu_enable_async_collective_fusion_fuse_all_reduce=false
--xla_tpu_enable_async_collective_fusion_fuse_reduce_scatter=false
--xla_tpu_enable_sparse_core_collective_offload_all_gather=true
--xla_tpu_enable_sparse_core_collective_offload_reduce_scatter=true
--xla_tpu_enable_sparse_core_collective_offload_all_reduce=true
--xla_tpu_enable_all_gather_offload_tracing=true
--xla_tpu_enable_reduce_scatter_offload_tracing=true
--xla_tpu_enable_all_reduce_offload_tracing=true
--xla_tpu_use_tc_device_shape_on_sc=true
--xla_sc_enable_instruction_fusion=false
--xla_sc_disjoint_spmem=false
--xla_sc_disable_megacore_partitioning=true
--xla_tpu_enable_all_experimental_scheduler_features=true
--xla_tpu_enable_scheduler_memory_pressure_tracking=true
--xla_tpu_host_transfer_overlap_limit=24
--xla_tpu_aggressive_opt_barrier_removal=ENABLED
--xla_lhs_prioritize_async_depth_over_stall=ENABLED
--xla_tpu_enable_ag_backward_pipelining=true
--xla_should_allow_loop_variant_parameter_in_chain=ENABLED
--xla_should_add_loop_invariant_op_in_chain=ENABLED
--xla_max_concurrent_host_send_recv=100
--xla_tpu_scheduler_percent_shared_memory_limit=100
--xla_latency_hiding_scheduler_rerun=2
--xla_tpu_use_minor_sharding_for_major_trivial_input=true
--xla_tpu_relayout_group_size_threshold_for_reduce_scatter=1
--xla_tpu_assign_all_reduce_scatter_layout=true
--xla_tpu_enable_data_parallel_all_reduce_opt=true
--xla_tpu_data_parallel_opt_different_sized_ops=true
--xla_tpu_scoped_vmem_limit_kib=81920
--xla_tpu_megacore_fusion_allow_ags=false
--xla_enable_async_collective_permute=true
