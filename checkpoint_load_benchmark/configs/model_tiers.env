# ==============================================================================
# MaxText Checkpoint Load-Time Benchmark: Model Tiers & Default Configuration
# ==============================================================================
#
# Supported Cluster Environments:
#   1. GKE TPU v5p Cluster (`bodaborg-v5p-nap`, europe-west4):
#      - Machine Type : ct5p-hightpu-4t (v5p-8, 2x2x1 topology)
#      - 1 Slice      : 1 host, 4 physical v5p chips (4 TPU devices), 368 GB HBM, ~270 GB Host RAM
#      - 2 Slices     : 2 hosts, 8 physical v5p chips (8 TPU devices), 736 GB HBM, ~540 GB Host RAM
#
#   2. GKE TPU v7 (Ironwood) Cluster (`bodaborg-tpu7x-nap`, us-central1):
#      - Machine Type : tpu7x-standard-4t (tpu7x, 2x2x1 topology)
#      - 1 Slice      : 1 host, 4 physical tpu7x chips (8 JAX TPU cores @ 101.725 GB/core = 813.80 GB HBM),
#                       1,014.50 GB (944.83 GiB) Host CPU RAM
#      - 2 Slices     : 2 hosts, 8 physical tpu7x chips (16 JAX TPU cores = 1,627.60 GB HBM),
#                       2,029.00 GB (1,889.66 GiB) Host CPU RAM
# ==============================================================================

# ------------------------------------------------------------------------------
# Part A: Original 12-Model Tier Matrix (bodaborg-v5p-nap)
# ------------------------------------------------------------------------------

# Tier 0: Small & Medium Models (<= 32B, 1.5 GB - 65.5 GB BF16)
# Fit comfortably on a single host in both scanned and unscanned modes.
TIER0_MODELS=(
  "qwen3-0.6b"
  "gemma2-2b"
  "deepseek2-16b"
  "qwen3-30b-a3b"
  "qwen3-32b"
)

# Tier 1: Large Models (47B - 70B, 93.4 GB - 141.1 GB BF16)
# Fit on a single 250-270 GB host with memory optimizations; benefit from 2-slice FSDP.
TIER1_MODELS=(
  "mixtral-8x7b"
  "llama3.1-70b"
)

# Tier 2: Single-Host v5p OOM Boundary Model (120B MoE, 233.7 GB BF16)
# OOMs on 1 v5p-8 slice (270 GB RAM), succeeds on 2 v5p-8 slices (540 GB RAM) or 1 tpu7x slice (1,014.5 GB RAM).
TIER2_MODELS=(
  "gpt-oss-120b"
)

# Tier 3: Ultra-Large DeepSeek OOM Test Models (284B - 1600B, 581.9 GB - 3,197.7 GB BF16)
TIER3_OOM_MODELS=(
  "deepseek4-284b"
  "deepseek3-671b"
  "deepseek3.2-671b"
  "deepseek4-1600b"
)

# Complete 12-Model v5p Suite (48 Configurations across scanned/unscanned x 1/2 slices)
ALL_MODELS=(
  "${TIER0_MODELS[@]}"
  "${TIER1_MODELS[@]}"
  "${TIER2_MODELS[@]}"
  "${TIER3_OOM_MODELS[@]}"
)

# ------------------------------------------------------------------------------
# Part B: TPU v7 (`bodaborg-tpu7x-nap`) Priority 1 (>200B) & Priority 2 (16 Models)
# ------------------------------------------------------------------------------

# Priority 1: >200B Ultra-Large Models on TPU v7 (tpu7x-standard-4t, 2x2x1)
# Benchmarks:
#   - Experiment 1A: safetensors_dynamic Before (origin/main) vs. After Lance's 3 PRs (#5706, #5828, #5705)
#   - Experiment 1B: to_maxtext (3-step Orbax) vs. safetensors_dynamic (2-step Direct) across 1 & 2 slices
TPU7X_PRIORITY1_200B_MODELS=(
  "qwen3-235b-a22b"     # 235B MoE (470.38 GB BF16, 118 shards) - fits on 1 slice (813.8 GB HBM) & 2 slices
  "deepseek4-284b"      # 284B MoE (581.89 GB BF16, 146 shards) - fits on 1 slice (813.8 GB HBM) & 2 slices
  "qwen3.5-397b-a17b"   # 397B Hybrid GatedDeltaNet MoE (795.48 GB BF16, 94 shards) - requires 2 slices (1,627.6 GB HBM)
  "qwen3-480b-a35b"     # 480B MoE (961.03 GB BF16, 241 shards) - requires 2 slices (1,627.6 GB HBM)
  "deepseek3-671b"      # 671B MoE (1,342.35 GB BF16, 336 shards) - requires 2 slices (1,627.6 GB HBM)
)

# Priority 2: 16-Model Benchmark Suite on TPU v7 (tpu7x-standard-4t, 2x2x1)
# 64 Configurations across scanned/unscanned x 1/2 slices
TPU7X_PRIORITY2_16_MODELS=(
  "qwen3-0.6b"
  "qwen3-4b"
  "qwen3-8b"
  "qwen3-14b"
  "qwen3-32b"
  "llama3.1-8b"
  "llama3.1-70b"
  "gemma2-2b"
  "gemma3-4b"
  "deepseek2-16b"
  "gpt-oss-20b"
  "qwen3-30b-a3b"
  "mixtral-8x7b"
  "gpt-oss-120b"
  "deepseek4-284b"
  "deepseek3-671b"
)

# ------------------------------------------------------------------------------
# Default Runtime & Cluster Settings
# ------------------------------------------------------------------------------
DEFAULT_SCAN_MODES=("scanned" "unscanned")
DEFAULT_GCS_BASE="${GCS_BASE:-gs://mesa-maxtext/benchmark_ckpt_load_time}"
DEFAULT_HARDWARE="${HARDWARE:-auto}"
DEFAULT_WEIGHT_DTYPE="${WEIGHT_DTYPE:-bfloat16}"
DEFAULT_DEVICES_PER_SLICE="${DEVICES_PER_SLICE:-4}"
DEFAULT_DCN_AXIS="${DCN_AXIS:-auto}"

# Default GKE TPU v5p Cluster Settings (for run_multi_slice_cluster.sh)
DEFAULT_CLUSTER_NAME="${CLUSTER_NAME:-bodaborg-v5p-nap}"
DEFAULT_CLUSTER_ZONE="${CLUSTER_ZONE:-europe-west4}"
DEFAULT_CLUSTER_PROJECT="${CLUSTER_PROJECT:-cloud-tpu-shared-capacity}"
DEFAULT_CONTAINER_IMAGE="${CONTAINER_IMAGE:-gcr.io/tpu-prod-env-multipod/maxtext_base_image:latest}"

# Default GKE TPU v7 (tpu7x) Cluster Settings (for run_tpu7x_cluster.sh)
DEFAULT_TPU7X_CLUSTER_CONTEXT="${TPU7X_CLUSTER_CONTEXT:-gke_cloud-tpu-shared-capacity_us-central1_bodaborg-tpu7x-nap}"
DEFAULT_TPU7X_GCS_BASE="${TPU7X_GCS_BASE:-gs://mesa-maxtext/mesakh_tpu7x_bench}"
DEFAULT_TPU7X_DEVICES_PER_SLICE="${TPU7X_DEVICES_PER_SLICE:-8}"
