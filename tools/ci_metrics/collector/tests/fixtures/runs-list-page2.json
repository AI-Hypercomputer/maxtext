5075/merge"}],"run_started_at":"2026-09-01T05:13:22Z","triggering_actor":{"login":"khatwanimohit","id":118776932,"node_id":"U_kgDOBxRkZA","avatar_url":"https://avatars.githubusercontent.com/u/118776932?v=4","gravatar_id":"","url":"https://api.github.com/users/khatwanimohit","html_url":"https://github.com/khatwanimohit","followers_url":"https://api.github.com/users/khatwanimohit/followers","following_url":"https://api.github.com/users/khatwanimohit/following{/other_user}","gists_url":"https://api.github.com/users/khatwanimohit/gists{/gist_id}","starred_url":"https://api.github.com/users/khatwanimohit/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/khatwanimohit/subscriptions","organizations_url":"https://api.github.com/users/khatwanimohit/orgs","repos_url":"https://api.github.com/users/khatwanimohit/repos","events_url":"https://api.github.com/users/khatwanimohit/events{/privacy}","received_events_url":"https://api.github.com/users/khatwanimohit/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/runs/33466797307/jobs","logs_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/runs/33466797307/logs","check_suite_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/check-suites/90684472824","artifacts_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/runs/33466797307/artifacts","cancel_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/runs/33466797307/cancel","rerun_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/runs/33466797307/rerun","previous_attempt_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/runs/33466797307/attempts/1","workflow_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/workflows/297948505","head_commit":{"id":"bde759abd93db8038365a9ee04b84b8b7f485134","tree_id":"32e6d405378755c69471b22993d0b8890dfc27ef","message":"Upgrade drjax to 0.2.1\n\nBump the drjax floor to the latest PyPI release in the base requirements\nand regenerate the generated_requirements/ locks with the seed-env flow\nfrom docs/development/update_dependencies.md. Regenerating re-resolves\neach lock in full, so the locks also pick up unrelated version bumps.\n\nPins llguidance<1.8.0 in the post-training base requirements: seed-env\ncannot resolve that lock otherwise, since vllm's tpu.txt constrains\nllguidance to <1.8.0 while the previously unpinned entry resolved to\n>=1.8.0. That break is independent of drjax and reproduces on main.\n\nRegenerating also moves tokamax to 0.0.13, which imports xprof at module\nscope. xprof is filtered out of the decoupled requirements because it\ndepends on gcsfs and google-cloud-storage, and maxtext imports tokamax\nfrom megablox, so every decoupled test that reaches maxtext.layers.moe\nstopped collecting, and letting xprof back in would make the Google Cloud\nclients importable in the one environment meant to prove they are absent.\n\nPin tokamax==0.0.12 for the decoupled requirements only, via a new\nPINNED_PACKAGES map in generate_decoupled_requirements.py. 0.0.12 is the\nlast release that does not need xprof, so that environment stays free of\nthe Cloud clients while the hardware locks keep tokamax 0.0.13.","timestamp":"2026-09-01T03:30:36Z","author":{"name":"khatwanimohit","email":"mohitkhatwani@google.com"},"committer":{"name":"khatwanimohit","email":"mohitkhatwani@google.com"}},"repository":{"id":607845880,"node_id":"R_kgDOJDr9-A","name":"maxtext","full_name":"AI-Hypercomputer/maxtext","private":false,"owner":{"login":"AI-Hypercomputer","id":181000646,"node_id":"O_kgDOCsnZxg","avatar_url":"https://avatars.githubusercontent.com/u/181000646?v=4","gravatar_id":"","url":"https://api.github.com/users/AI-Hypercomputer","html_url":"https://github.com/AI-Hypercomputer","followers_url":"https://api.github.com/users/AI-Hypercomputer/followers","following_url":"https://api.githu