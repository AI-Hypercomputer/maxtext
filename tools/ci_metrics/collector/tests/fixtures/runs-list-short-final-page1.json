ff8b748f7db60c573afb92085183b3","sha":"8452532b41ff8b748f7db60c573afb92085183b3","ref":"refs/pull/4968/merge"}],"run_started_at":"2026-08-26T19:10:45Z","triggering_actor":{"login":"WandLZhang","id":34315237,"node_id":"MDQ6VXNlcjM0MzE1MjM3","avatar_url":"https://avatars.githubusercontent.com/u/34315237?v=4","gravatar_id":"","url":"https://api.github.com/users/WandLZhang","html_url":"https://github.com/WandLZhang","followers_url":"https://api.github.com/users/WandLZhang/followers","following_url":"https://api.github.com/users/WandLZhang/following{/other_user}","gists_url":"https://api.github.com/users/WandLZhang/gists{/gist_id}","starred_url":"https://api.github.com/users/WandLZhang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/WandLZhang/subscriptions","organizations_url":"https://api.github.com/users/WandLZhang/orgs","repos_url":"https://api.github.com/users/WandLZhang/repos","events_url":"https://api.github.com/users/WandLZhang/events{/privacy}","received_events_url":"https://api.github.com/users/WandLZhang/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/runs/33003763519/jobs","logs_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/runs/33003763519/logs","check_suite_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/check-suites/89409740472","artifacts_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/runs/33003763519/artifacts","cancel_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/runs/33003763519/cancel","rerun_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/runs/33003763519/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/actions/workflows/297948505","head_commit":{"id":"2dd2a9e446698be186480ce4013ccf0466d89bd6","tree_id":"2eb5182a25aff9532059a99b4d10fde9299653d7","message":"Shard the GatedDeltaNet sequence under ici_context_parallelism\n\nTwo pspecs pinned the GDN sequence axis to None and the inter-chunk\nrecurrence was a sequential lax.scan, so ici_context_parallelism could\nnot shard the GDN sequence at all.\n\nThe recurrence is affine in the state:\n\n    h' = (exp(g_last).I - k_g^T.w).h + k_g^T.u = A.h + B\n\nEach device folds its local chunks into one (A, B) pair with a lax.scan,\nnot associative_scan, which would materialize the running composition\nper chunk. The pairs are composed across devices with a Hillis-Steele\nprefix scan over ppermute: log2(D) exchanges holding one pair, O(1) in\nthe device count.\n\nAn all-gather also works and is what the first version of this PR did,\nbut it materializes [D, B, H, K, K] and [D, B, H, K, V] on every device.\nThat is O(D) per layer and makes per-device memory grow with the context\naxis rather than shrink; on Qwen3.5-27B at ctx=256 it is about 38 GB\nacross the 48 GatedDeltaNet layers.\n\nThe second pspec fix matters as much as the scan. qkvz_pspec had the\nsequence axis hardcoded replicated, which told XLA to gather the full\nsequence onto every device: at ctx=2, seq 32,768, six live\nbf16[2,32768,16,512] buffers of 1.07 GB each.\n\nMeasured on Qwen3.5-27B, 256 v5p, ctx=256, fsdp=1, one 4,096-token\nsequence per device: 1,048,576 tokens, loss 12.923 to 10.583, 485.5\ntokens/s/chip. Also 524,288 on the same slice and 131,072 on 64 chips.\nMemory tracks tokens per device, not the context degree.\n\nSet per_device_batch_size to 1/ici_context_parallelism. local_batch is\nper_device_batch_size x ctx, so leaving it at 1 grows the local batch\nwith the context axis and runs out of memory.\n\ntests/unit/gdn_cp_test.py covers three things. compose_local, against\nthe recurrence applied chunk by chunk in its original form, so the\nreference never builds A or B and checks the affine reformulation rather\nthan restating it. incoming_state on a single-device mesh. And\nincoming_state against a sequential composition on a forced 8-device CPU\nmesh, over a 1-D context mesh, a 2-D fsdp x context mesh, and a tuple\naxis name, which is what qwen3.py passes when more than one context knob\nis set. Each has a negative control.","timestamp":"2026-08-26T19:10:36Z","author":{"name":"Willis Zhang","email":"williszhang@google.com"},"committer":{"name":"Willis Zhang","email":"williszhang@google.com"}},"repository":{"id":607845880,"node_id":"R_kgDOJDr9-A","name":"maxtext","full_name":"AI-Hypercomputer/maxtext","private":false,"owner":{"login":"AI-Hypercomputer","id":181000646,"node_id":"O_kgDOCsnZxg","avatar_url":"https://avatars.githubusercontent.com/u/181000646?v=4","gravatar_id":"","url":"https://api.github.com/users/AI-Hypercomputer","html_url":"https://github.com/AI-Hypercomputer","followers_url":"https://api.github.com/users/AI-Hypercomputer/followers","following_url":"https://api.github.com/users/AI-Hypercomputer/following{/other_user}","gists_url":"https://api.github.com/users/AI-Hypercomputer/gists{/gist_id}","starred_url":"https://api.github.com/users/AI-Hypercomputer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AI-Hypercomputer/subscriptions","organizations_url":"https://api.github.com/users/AI-Hypercomputer/orgs","repos_url":"https://api.github.com/users/AI-Hypercomputer/repos","events_url":"https://api.github.com/users/AI-Hypercomputer/events{/privacy}","received_events_url":"https://api.github.com/users/AI-Hypercomputer/received_events","type":"Organization","user_view_type":"public","site_admin":false},"html_url":"https://github.com/AI-Hypercomputer/maxtext","description":"A simple, performant, and scalable Jax LLM!","fork":false,"url":"https://api.github.com/repos/AI-Hypercomputer/maxtext","forks_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/forks","keys_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/keys{/key_id}","collaborators_url":"https://api.github.com/repos/AI-Hypercomputer/maxtext/collaborators{/collaborator}